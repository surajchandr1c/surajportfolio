## Contact form email (server-side)
## Choose ONE of the following setups.

## Option A (Recommended): Generic SMTP
## Works with providers like Zoho, Brevo, Outlook, etc.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# EMAIL_TO=you@example.com

## Option B: Gmail (requires a Google App Password if 2FA is enabled)
## If you don't set SMTP_HOST, the app defaults to Gmail via Nodemailer service transport.
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_TO=yourgmail@gmail.com

## Optional debugging/tuning
# SMTP_SERVICE=gmail
# SMTP_ALLOW_SELF_SIGNED=false
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000
